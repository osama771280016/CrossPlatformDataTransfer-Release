<Window x:Class="CrossPlatformDataTransfer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="نقل البيانات — TransferAI"
        Height="760" Width="1080" MinHeight="680" MinWidth="920" WindowState="Maximized"
        Background="#F3F6FA" FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#246BFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF1FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="نقل البيانات" FontSize="27" FontWeight="Bold" Foreground="#17243A"/>
                <TextBlock Text="إدارة اتصال هاتفك ونقل بياناتك بخطوات واضحة" FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E9F2FF" CornerRadius="20" Padding="13,7" VerticalAlignment="Center">
                <TextBlock Text="معاينة تطويرية" Foreground="#2458A6" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Main dashboard -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Devices card -->
            <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="الأجهزة" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="اختر الهاتف المتصل عبر USB" FontSize="12" Foreground="#8492A6" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="فحص الأجهزة المتصلة"
                            Command="{Binding DiscoverDevicesCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"/>
                    <Grid>
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 BorderThickness="0" Background="Transparent" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FlowDirection="LeftToRight" TextAlignment="Left"
                                                   FontWeight="SemiBold" Foreground="#26364D" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#7B8BA1" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="لم يظهر هاتف بعد. تحقق من كابل USB وتصحيح USB، ثم أعد الفحص."
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12"
                                   Margin="10,24" IsHitTestVisible="False" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Secure connection card -->
            <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="26">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="الاتصال الآمن" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="اربط الهاتف مرة واحدة، ثم أكّد أن الاتصال يعود إلى جهازك." FontSize="13"
                                   Foreground="#718096" TextWrapping="Wrap" Margin="0,5,0,18"/>

                        <Border Background="#F8FAFC" BorderBrush="#E8EDF4" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#E6EEFF" VerticalAlignment="Top">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2458A6" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="شغّل الوكيل على الهاتف" FontWeight="SemiBold" Foreground="#26364D"/>
                                    <TextBlock Text="افتح TransferAI Agent على Android واضغط بدء الاتصال. يجب أن يكون USB debugging مفعّلًا ومصرّحًا لهذا الكمبيوتر." FontSize="12"
                                               Foreground="#718096" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E8EDF4" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#E6EEFF" VerticalAlignment="Top">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2458A6" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="أدخل رمز الاقتران المؤقت" FontWeight="SemiBold" Foreground="#26364D"/>
                                    <TextBlock Text="هذا الرمز يثبت طلب الاقتران. أدخله هنا فقط؛ لا تشاركه في المحادثات." FontSize="12"
                                               Foreground="#718096" TextWrapping="Wrap" Margin="0,5,0,9"/>
                                    <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="8" Width="220" Height="42" HorizontalAlignment="Right"
                                             FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="19"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             Background="White" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="اتصال آمن وعرض بصمة التحقق"
                                Command="{Binding ConnectAgentCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                        <Border Background="#EFFAF7" BorderBrush="#C8EDE2" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#D7F3E9" VerticalAlignment="Top">
                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#14745B" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="قارن بصمة TLS على الشاشتين" FontWeight="SemiBold" Foreground="#195B4B"/>
                                    <TextBlock Text="هذه البصمة ليست سرًا ولا تُرسلها. تابع فقط إذا تطابقت تمامًا، ثم أكّد على الهاتف." FontSize="12"
                                               Foreground="#52766D" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                    <TextBlock Text="{Binding VerificationCode}" FlowDirection="LeftToRight" TextAlignment="Right"
                                               FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#0F766E"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="تطابقت البصمة — أكمل الاقتران"
                                Command="{Binding ConfirmAndPairCommand}"
                                IsEnabled="{Binding IsSecureChannelReady}"
                                Style="{StaticResource PrimaryButton}" Background="#11856A" HorizontalAlignment="Stretch" Margin="0,0,0,9"/>
                        <Button Content="قطع الاتصال" Command="{Binding DisconnectAgentCommand}"
                                IsEnabled="{Binding IsDisconnectAvailable}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>

                        <Border Background="#FFF8E8" BorderBrush="#F4E2B9" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,16,0,0">
                            <TextBlock Text="تنبيه: هذه النسخة تختبر الاتصال والاقتران وقراءة معلومات عامة فقط. نقل الملفات والنسخ الاحتياطي لم يُفعّلا بعد." FontSize="12"
                                       Foreground="#775C26" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#334155" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Left" Foreground="#718096"/>
                </Grid>
                <ProgressBar Height="8" Value="{Binding TransferProgress}" Maximum="100"
                             Background="#E7EDF5" Foreground="#246BFD" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
